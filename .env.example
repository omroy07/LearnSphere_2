# LearnSphere Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Google Gemini AI API Key (optional for auth-only development)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model (optional)
# Available models: https://ai.google.dev/gemini-api/docs/models
# Defaults to gemini-2.5-flash if not set.
GEMINI_MODEL=gemini-2.5-flash

# Flask Configuration
# Set to "true" only during local development — NEVER in production
FLASK_DEBUG=false

# Authentication (Node.js server — npm run auth)
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRY_DAYS=7
AUTH_PORT=5001

# Database path for Node auth (SQLite)
# Default: instance/learnsphere.db in the project root
DATABASE_PATH=

# App base URL for password reset and email verification links
APP_BASE_URL=http://localhost:5173

# Optional SMTP for email verification and password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@learnsphere.com
