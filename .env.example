# LearnSphere Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Google Gemini AI API Key
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini Model (optional)
# Available models: https://ai.google.dev/gemini-api/docs/models
# Defaults to gemini-2.5-flash if not set.
GEMINI_MODEL=gemini-2.5-flash

# Flask Configuration
# Set to "true" only during local development — NEVER in production
FLASK_DEBUG=false
